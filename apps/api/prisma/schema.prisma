generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENTE
  PRESTADOR
  ADMIN
}

enum Selo {
  NENHUM
  PRATA
  OURO
  PREMIUM
}

enum BusinessMode {
  GESTAO
  COMPLETO
  CONTRATACAO
}

enum BookingStatus {
  SOLICITADO
  ACEITO
  RECUSADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum Plan {
  GRATIS
  PRO
  BUSINESS
  PREMIUM
}

enum SubscriptionStatus {
  ATIVA
  TESTE
  PAGAMENTO_PENDENTE
  CANCELAMENTO_SOLICITADO
  CANCELADA
  INADIMPLENTE
  EXPIRADA
}

enum PersonType {
  PF
  PJ
}

enum RequestStatus {
  ABERTA
  EM_ANDAMENTO
  FECHADA
  CANCELADA
}

enum NotificationType {
  NOVA_MENSAGEM
  NOVA_PROPOSTA
  PROPOSTA_ACEITA
  NOVA_OPORTUNIDADE
  PLANO_EXPIRANDO
  PLANO_EXPIRADO
  VAGA_RESERVADA
  LEMBRETE_MANUTENCAO
  LEMBRETE_AVALIACAO
  RESUMO_SEMANAL
  LEMBRETE_COMPROMISSO
  VENDA_REGISTRADA
  META_ATINGIDA
}

enum IncomeSource {
  MANUAL
  RESERVA
}

enum DealStatus {
  ATIVA
  RESERVADA
  CANCELADA
}

enum ProposalStatus {
  ENVIADA
  ACEITA
  RECUSADA
}

enum ReportTargetType {
  USUARIO
  AVALIACAO
  SERVICO
  RESERVA
}

enum ReportReason {
  SPAM
  GOLPE_FRAUDE
  CONTEUDO_INAPROPRIADO
  ASSEDIO
  SERVICO_NAO_CONFORME
  OUTRO
}

enum ReportStatus {
  PENDENTE
  EM_ANALISE
  RESOLVIDO
  REJEITADO
}

enum IdentityStatus {
  NAO_ENVIADO
  PENDENTE
  APROVADO
  REJEITADO
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role     @default(CLIENTE)
  avatarUrl     String?
  city          String?
  cpf           String?  @unique
  cnpj          String?  @unique
  personType    PersonType?
  razaoSocial   String?
  nomeFantasia  String?
  addressCep    String?
  addressStreet String?
  addressNumber String?
  addressState  String?
  bio           String?
  verified      Boolean  @default(false)
  deletedAt     DateTime?
  // Incrementado a cada troca/redefinição de senha — invalida na hora qualquer
  // JWT emitido antes disso, mesmo que ainda não tenha expirado (ver JwtStrategy).
  tokenVersion  Int      @default(0)

  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime?
  passwordResetToken         String?   @unique
  passwordResetExpiresAt     DateTime?

  identityStatus          IdentityStatus @default(NAO_ENVIADO)
  identityDocumentUrl     String?
  identityRejectionReason String?
  identitySubmittedAt     DateTime?
  identityReviewedAt      DateTime?
  identityReviewedById    String?
  identityReviewedBy      User?          @relation("IdentityReviewedBy", fields: [identityReviewedById], references: [id])
  identityReviewsDone     User[]         @relation("IdentityReviewedBy")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  providerProfile ProviderProfile?
  reviewsWritten  Review[]         @relation("ReviewsByClient")
  bookingsAsClient Booking[]       @relation("BookingsByClient")
  messagesSent    Message[]        @relation("MessagesBySender")
  conversationsA  Conversation[]   @relation("ConversationClient")
  favorites       Favorite[]
  serviceRequests ServiceRequest[] @relation("ServiceRequestsByClient")
  notifications   Notification[]
  dealsClaimed    LastMinuteDeal[] @relation("DealsClaimedByClient")
  pushSubscriptions PushSubscription[]

  reportsFiled      Report[] @relation("ReportsByReporter")
  reportsResolved   Report[] @relation("ReportsByResolver")
  reportsResponded  Report[] @relation("ReportsByRespondent")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String

  createdAt DateTime @default(now())
}

model ProviderProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialty     String
  categories    String[]
  bio           String?
  city          String
  yearsExperience Int    @default(0)
  selo          Selo     @default(NENHUM)
  scoreIA       Float    @default(0)
  ratingAvg     Float    @default(0)
  servicesDone  Int      @default(0)
  clientsCount  Int      @default(0)
  businessHours Json?
  planPriority  Int      @default(0)
  boostExpiresAt DateTime?
  profileViews  Int      @default(0)
  searchAppearances Int  @default(0)
  availableNow  Boolean  @default(false)
  availableUntil DateTime?

  // null = ainda não escolheu (conta antiga de antes dessa opção existir, ou
  // cadastro feito direto pela API sem passar pela tela de intenção) — nesse
  // caso a pessoa é perguntada uma vez no primeiro acesso.
  businessMode  BusinessMode?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services      Service[]
  media         Media[]
  reviews       Review[]        @relation("ReviewsForProvider")
  bookings      Booking[]       @relation("BookingsForProvider")
  conversationsB Conversation[] @relation("ConversationProvider")
  favoritedBy   Favorite[]
  subscription  Subscription?
  proposals     Proposal[]
  lastMinuteDeals LastMinuteDeal[]
  expenses      Expense[]
  incomes       Income[]
  appointments  Appointment[]
  financialGoals FinancialGoal[]

  @@index([city])
}

model Expense {
  id          String   @id @default(cuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  description String
  category    String
  amount      Float
  date        DateTime @default(now())

  isRecurring       Boolean  @default(false)
  recurringParentId String?
  recurringParent   Expense?  @relation("RecurringExpenseClones", fields: [recurringParentId], references: [id], onDelete: Cascade)
  recurringClones   Expense[] @relation("RecurringExpenseClones")

  createdAt   DateTime @default(now())

  @@index([providerId, date])
}

model Income {
  id          String   @id @default(cuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  description String
  amount      Float
  date        DateTime @default(now())

  source      IncomeSource @default(MANUAL)
  bookingId   String?  @unique
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@index([providerId, date])
}

model FinancialGoal {
  id           String   @id @default(cuid())
  providerId   String
  provider     ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  month        String   // "YYYY-MM"
  targetAmount Float
  reachedAt    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([providerId, month])
}

model Appointment {
  id          String   @id @default(cuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  title       String
  notes       String?
  scheduledAt DateTime
  notifiedAt  DateTime?

  createdAt   DateTime @default(now())

  @@index([providerId, scheduledAt])
}

model Subscription {
  id                String             @id @default(cuid())
  providerId        String             @unique
  provider          ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  plan              Plan               @default(GRATIS)
  status            SubscriptionStatus @default(ATIVA)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)

  aiUsageCount      Int                @default(0)
  aiUsagePeriod     String             @default("")

  proposalsUsedCount  Int              @default(0)
  proposalsUsedPeriod String           @default("")

  // Marca que esse prestador já usou o período de teste gratuito — só dá pra
  // usar uma vez, nunca mais reseta mesmo depois de voltar pro Grátis.
  trialUsedAt       DateTime?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  providerId    String
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  title         String
  description   String
  category      String
  priceMin      Float?
  priceMax      Float?
  estimatedTime String?
  active        Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings      Booking[]
  media         Media[]

  @@index([providerId])
}

model Media {
  id            String   @id @default(cuid())
  providerId    String
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  type          String
  url           String
  title         String?
  caption       String?
  beforeUrl     String?
  afterUrl      String?
  createdAt     DateTime @default(now())
}

model Review {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  clientId      String
  client        User     @relation("ReviewsByClient", fields: [clientId], references: [id])

  providerId    String
  provider      ProviderProfile @relation("ReviewsForProvider", fields: [providerId], references: [id], onDelete: Cascade)

  rating        Float
  pontualidade  Float
  qualidade     Float
  preco         Float
  atendimento   Float
  comment       String?
  photoUrls     String[]
  videoUrl      String?
  audioUrl      String?

  createdAt     DateTime @default(now())

  @@index([providerId])
}

model Booking {
  id            String   @id @default(cuid())
  clientId      String
  client        User     @relation("BookingsByClient", fields: [clientId], references: [id])

  providerId    String
  provider      ProviderProfile @relation("BookingsForProvider", fields: [providerId], references: [id])

  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id])

  status        BookingStatus @default(SOLICITADO)
  scheduledAt   DateTime?
  address       String?
  notes         String?
  priceQuoted   Float?
  category      String?
  reviewReminderSentAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  review        Review?
  income        Income?

  @@index([clientId])
  @@index([providerId, status])
}

model Conversation {
  id            String   @id @default(cuid())
  clientId      String
  client        User     @relation("ConversationClient", fields: [clientId], references: [id])

  providerId    String
  provider      ProviderProfile @relation("ConversationProvider", fields: [providerId], references: [id])

  createdAt     DateTime @default(now())
  messages      Message[]

  @@unique([clientId, providerId])
  @@index([providerId])
}

model Message {
  id            String   @id @default(cuid())
  conversationId String
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId      String
  sender        User     @relation("MessagesBySender", fields: [senderId], references: [id])

  type          String   @default("text")
  content       String
  createdAt     DateTime @default(now())

  @@index([conversationId])
}

model Favorite {
  id            String   @id @default(cuid())
  clientId      String
  client        User     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  providerId    String
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@unique([clientId, providerId])
  @@index([providerId])
}

model ServiceRequest {
  id            String   @id @default(cuid())
  clientId      String
  client        User     @relation("ServiceRequestsByClient", fields: [clientId], references: [id], onDelete: Cascade)

  category      String
  title         String
  description   String
  city          String
  state         String?
  budgetMin     Float?
  budgetMax     Float?
  desiredDate   DateTime?
  desiredTime   String?
  status        RequestStatus @default(ABERTA)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  proposals     Proposal[]

  @@index([clientId])
  @@index([status, category])
}

model Proposal {
  id            String   @id @default(cuid())
  requestId     String
  request       ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  providerId    String
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  price         Float
  message       String
  deadline      String?
  availableAt   String?
  status        ProposalStatus @default(ENVIADA)

  createdAt     DateTime @default(now())

  @@unique([requestId, providerId])
  @@index([providerId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)

  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model LastMinuteDeal {
  id            String   @id @default(cuid())
  providerId    String
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  category      String
  title         String
  description   String?
  city          String
  state         String?
  originalPrice Float
  dealPrice     Float
  scheduledAt   DateTime
  status        DealStatus @default(ATIVA)

  claimedById   String?
  claimedBy     User?    @relation("DealsClaimedByClient", fields: [claimedById], references: [id])
  claimedAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, scheduledAt])
}

model Report {
  id         String           @id @default(cuid())

  reporterId String
  reporter   User             @relation("ReportsByReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  targetId   String

  reason     ReportReason
  details    String?

  status     ReportStatus     @default(PENDENTE)

  resolvedById   String?
  resolvedBy     User?        @relation("ReportsByResolver", fields: [resolvedById], references: [id])
  resolutionNote String?
  resolvedAt     DateTime?

  respondentId        String?
  respondent          User?    @relation("ReportsByRespondent", fields: [respondentId], references: [id])
  respondentStatement String?
  respondedAt         DateTime?

  createdAt  DateTime         @default(now())

  @@index([targetType, targetId])
  @@index([status])
}
